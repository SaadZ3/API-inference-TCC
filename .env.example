# Caminhos relativos ao diretório tcc-inference, MODEL_DIR é usado na CLI P3; demais opções de análise são da P4/P5.
MODEL_DIR="../OPP-115 Treinamento/Tratamento e Treinamento/Treinamento/modelo"
SCORING_RULES="../OPP-115 Treinamento/Tratamento e Treinamento/Treinamento/config/scoring.yaml"
RECOMMENDATIONS_CATALOG="../OPP-115 Treinamento/Tratamento e Treinamento/Treinamento/config/recommendations.yaml"
DEVICE=cpu
MAX_UPLOAD_BYTES=10485760

# Um worker/processo. Ajustar somente após medir novamente.
BATCH_SIZE=4
CPU_THREADS=4
ANALYSIS_TIMEOUT_SECONDS=120
UPLOAD_TIMEOUT_SECONDS=30
