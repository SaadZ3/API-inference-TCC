# Caminhos relativos ao diretório tcc-inference, MODEL_DIR é usado na CLI P3; demais opções de análise são da P4/P5.
MODEL_DIR=model
SCORING_RULES=config/scoring.yaml
RECOMMENDATIONS_CATALOG=config/recommendations.yaml
# No Railway: URL HTTPS pública do anexo model.safetensors da Release.
# MODEL_WEIGHTS_URL=https://github.com/USUARIO/REPOSITORIO/releases/download/model-v1/model.safetensors
DEVICE=cpu
MAX_UPLOAD_BYTES=10485760

# Um worker/processo. Ajustar somente após medir novamente.
BATCH_SIZE=4
CPU_THREADS=4
ANALYSIS_TIMEOUT_SECONDS=120
UPLOAD_TIMEOUT_SECONDS=30

# PORT, quando fornecida pelo Railway, define a porta do script start_railway.py.
# Testes podem usar TCC_TEST_MODEL_DIR para selecionar outro pacote local.
